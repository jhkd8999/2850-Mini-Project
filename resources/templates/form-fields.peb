<label for="emailField">Email Address</label>
<input id="emailField" name="email" type="email">
<label for="passwordField">Password</label>
<input id="passwordField" name="password" type="password">
<label for="firstNameField">First Name</label>
<input id="firstNameField" name="firstName">
<label for="lastNameField">Last Name</label>
<input id="lastNameField" name="lastName">
<label for="addressField">Home Address</label>
<input id="addressField" name="address">