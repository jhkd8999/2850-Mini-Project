{% extends "base.peb" %}
{% block content %}
<h1>New User Registration</h1>
<p>Register here with a few personal details, or return to the
<a href="/">home page</a>.</p>
<p>Note:</p>
<ul>
  <li>Passwords must be a minimum of 8 characters, none of which can be whitespace</li>
</ul>
<form action="/register" method="POST">
  {% include "form-fields.peb" %}
  <input type="submit" value="Register">
</form>
{% include "form-error.peb" %}
{% endblock %}